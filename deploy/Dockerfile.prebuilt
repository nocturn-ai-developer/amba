# App image from a Next.js build made elsewhere (for hosts too small to run `next build`).
# Build context = a folder with app/ = .next/standalone, plus .next/static, public, prisma, scripts
# and contracts copied into it (the same layout the main Dockerfile's run stage produces).
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S prismatic && adduser -S prismatic -G prismatic && mkdir -p /data && chown prismatic:prismatic /data \
 && npm install -g prisma@6.19.3 --no-audit --no-fund \
 && mkdir /tmp/sharp && cd /tmp/sharp && npm init -y >/dev/null && npm install sharp@0.35.5 --no-audit --no-fund \
 && npm cache clean --force
COPY app/ ./
# The build machine may be Windows/macOS: swap in the Linux (musl) sharp binaries.
RUN rm -rf node_modules/sharp node_modules/@img && cp -r /tmp/sharp/node_modules/. node_modules/ && rm -rf /tmp/sharp
USER prismatic
EXPOSE 3000
CMD ["sh", "-c", "prisma migrate deploy && node server.js"]
